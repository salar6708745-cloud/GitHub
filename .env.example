# Google Gemini API Configuration
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Google Cloud Services Configuration
# Download service account JSON from Google Cloud Console
# Set the path to your service account credentials file
GOOGLE_APPLICATION_CREDENTIALS=./path/to/your/service-account.json

# Server Configuration
PORT=3000
NODE_ENV=development

# Frontend URL (for CORS configuration)
FRONTEND_URL=http://localhost:3000

# Optional: Session Configuration (if implementing conversation storage)
# SESSION_SECRET=your_session_secret_here

# Optional: Database Configuration (if storing conversations)
# DATABASE_URL=mongodb://localhost:27017/salar-voice-agent